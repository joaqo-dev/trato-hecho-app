# Copiar a .env en el servidor (chmod 600 .env). Nunca subir .env a git.

# Contraseña de la base PostgreSQL. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Usuario del panel web (/panel)
PANEL_CORREO=panel@tratohecho.cl
# Clave del panel web: elígela tú y escríbela directamente en el servidor
PANEL_CLAVE=
