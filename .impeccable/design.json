  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "boton-principal",
      "description": "Píldora primary de ancho completo, 56dp; cruza a un loader al procesar.",
      "html": "<button class=\"ds-btn-principal\">Enviar cotización</button>",
      "css": ".ds-btn-principal{font-family:Roboto,system-ui,sans-serif;background:#0A0A0A;color:#fff;border:none;border-radius:9999px;height:56px;width:100%;font-size:15px;font-weight:600;transition:transform 120ms cubic-bezier(0.23,1,0.32,1);} .ds-btn-principal:active{transform:scale(0.97);} .ds-btn-principal:focus-visible{outline:2px solid #0A0A0A;outline-offset:3px;} .ds-btn-principal:disabled{background:rgba(10,10,10,0.3);}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "boton-secundario",
      "description": "Píldora contorneada de 52dp para acciones de menor prioridad; variante destructiva en rojo.",
      "html": "<button class=\"ds-btn-secundario\">Duplicar</button>",
      "css": ".ds-btn-secundario{font-family:Roboto,system-ui,sans-serif;background:transparent;color:#0A0A0A;border:1px solid #D4D4D8;border-radius:9999px;height:52px;width:100%;font-size:15px;font-weight:600;transition:transform 120ms cubic-bezier(0.23,1,0.32,1),background 200ms;} .ds-btn-secundario:hover{background:#F7F7F8;} .ds-btn-secundario:active{transform:scale(0.97);} .ds-btn-secundario:focus-visible{outline:2px solid #0A0A0A;outline-offset:3px;}"
    },
    {
      "name": "Tarjeta hero",
      "kind": "custom",
      "refersTo": "tarjeta-hero",
      "description": "Una por pantalla: cifra Display con cifras tabulares y dos botones píldora.",
      "html": "<div class=\"ds-hero\"><div class=\"ds-hero-label\">Cotizado este mes</div><div class=\"ds-hero-monto\">$ 3.639.727</div><div class=\"ds-hero-acciones\"><button class=\"ds-hero-btn\">+ Cotizar</button><button class=\"ds-hero-btn\">Nuevo cliente</button></div></div>",
      "css": ".ds-hero{font-family:Roboto,system-ui,sans-serif;background:#0A0A0A;border:1px solid #0A0A0A;border-radius:28px;padding:20px;color:#fff;} .ds-hero-label{color:#B4B4BB;font-size:14px;} .ds-hero-monto{font-size:34px;line-height:40px;font-weight:700;letter-spacing:-0.8px;font-variant-numeric:tabular-nums;margin-top:6px;} .ds-hero-acciones{display:flex;gap:10px;margin-top:20px;} .ds-hero-btn{flex:1;height:52px;background:#F4F4F5;color:#0A0A0A;border:none;border-radius:9999px;font:600 15px Roboto,system-ui,sans-serif;transition:transform 120ms cubic-bezier(0.23,1,0.32,1);} .ds-hero-btn:active{transform:scale(0.97);} .ds-hero-btn:focus-visible{outline:2px solid #fff;outline-offset:2px;}"
    },
    {
      "name": "Tarjeta de cotización",
      "kind": "card",
      "refersTo": "tarjeta",
      "description": "Guía de despacho: número + chip, cliente + total, tracker compacto.",
      "html": "<div class=\"ds-card\"><div class=\"ds-row\"><div><div class=\"ds-et\">N° de cotización</div><div class=\"ds-num\">COT-0005</div></div><span class=\"ds-chip ds-chip-aceptada\">Aceptada</span></div><div class=\"ds-row\" style=\"margin-top:16px\"><div><div class=\"ds-et\">Cliente</div><div class=\"ds-cli\">Comercial Biobío Ltda.</div></div><div style=\"text-align:right\"><div class=\"ds-et\">Total</div><div class=\"ds-num\">UF 67,83</div></div></div></div>",
      "css": ".ds-card{font-family:Roboto,system-ui,sans-serif;background:#F4F4F5;border-radius:24px;padding:18px;color:#0A0A0A;transition:transform 120ms cubic-bezier(0.23,1,0.32,1);cursor:pointer;} .ds-card:active{transform:scale(0.97);} .ds-card:focus-visible{outline:2px solid #0A0A0A;outline-offset:2px;} .ds-row{display:flex;justify-content:space-between;align-items:flex-start;} .ds-et{font-size:12px;color:#6B6B72;margin-bottom:2px;} .ds-num{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;} .ds-cli{font-size:16px;font-weight:500;} .ds-chip{font-size:12px;font-weight:500;border-radius:9999px;padding:7px 14px;} .ds-chip-aceptada{background:#E3F6EA;color:#15803D;}"
    },
    {
      "name": "Chip de estado",
      "kind": "chip",
      "refersTo": "chip-estado-enviada",
      "description": "Par fondo suave + texto por estado; En cola usa ámbar.",
      "html": "<span class=\"ds-chip ds-enviada\">Enviada</span> <span class=\"ds-chip ds-aceptada\">Aceptada</span> <span class=\"ds-chip ds-rechazada\">Rechazada</span> <span class=\"ds-chip ds-facturada\">Facturada</span> <span class=\"ds-chip ds-cola\">En cola</span>",
      "css": ".ds-chip{font-family:Roboto,system-ui,sans-serif;display:inline-block;font-size:12px;line-height:16px;font-weight:500;border-radius:9999px;padding:7px 14px;transition:background 280ms,color 280ms;} .ds-enviada{background:#E8F0FE;color:#2563EB;} .ds-aceptada{background:#E3F6EA;color:#15803D;} .ds-rechazada{background:#FDECEC;color:#C62828;} .ds-facturada{background:#F1EBFD;color:#6D28D9;} .ds-cola{background:#FFF1DE;color:#B45309;}"
    },
    {
      "name": "Buscador píldora",
      "kind": "input",
      "refersTo": "campo-busqueda",
      "description": "Píldora de 56dp con borde de 1dp y lupa.",
      "html": "<label class=\"ds-buscar\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#6B6B72\"><path d=\"M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/></svg><input placeholder=\"Buscar cotización o cliente\"></label>",
      "css": ".ds-buscar{font-family:Roboto,system-ui,sans-serif;display:flex;align-items:center;gap:12px;height:56px;padding:0 16px;background:#fff;border:1px solid #D4D4D8;border-radius:9999px;} .ds-buscar:focus-within{border:2px solid #0A0A0A;} .ds-buscar input{border:none;outline:none;background:transparent;font-size:16px;flex:1;color:#0A0A0A;} .ds-buscar input::placeholder{color:#6B6B72;}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "campo-texto",
      "description": "Campo contorneado de radio 16dp con ícono inicial y mensaje de error bajo el campo.",
      "html": "<div class=\"ds-campo\"><input placeholder=\"Correo\"><div class=\"ds-campo-ayuda\">Ingresa un correo válido, por ejemplo nombre@empresa.cl</div></div>",
      "css": ".ds-campo input{font-family:Roboto,system-ui,sans-serif;width:100%;height:56px;padding:0 16px;border:1px solid #D4D4D8;border-radius:16px;font-size:16px;background:transparent;} .ds-campo input:focus{outline:none;border:2px solid #0A0A0A;} .ds-campo-ayuda{font-size:12px;color:#D92D20;margin:4px 16px 0;}"
    },
    {
      "name": "Barra de navegación flotante",
      "kind": "nav",
      "refersTo": "barra-navegacion",
      "description": "Píldora flotante con sombra 12dp; pestaña activa primary con ícono + nombre.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item ds-activo\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>Inicio</button><button class=\"ds-nav-item\" aria-label=\"Cotizaciones\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z\"/></svg></button></nav>",
      "css": ".ds-nav{font-family:Roboto,system-ui,sans-serif;display:inline-flex;gap:2px;padding:6px;background:#fff;border-radius:9999px;box-shadow:0 6px 24px rgba(0,0,0,0.16);} .ds-nav-item{display:flex;align-items:center;gap:8px;min-width:52px;height:52px;padding:0 15px;border:none;border-radius:9999px;background:transparent;color:#6B6B72;font-size:15px;font-weight:600;transition:background 200ms,color 200ms,transform 120ms cubic-bezier(0.23,1,0.32,1);} .ds-nav-item:active{transform:scale(0.97);} .ds-nav-item:focus-visible{outline:2px solid #0A0A0A;outline-offset:2px;} .ds-activo{background:#0A0A0A;color:#fff;}"
    },
    {
      "name": "Tracker de cotización",
      "kind": "custom",
      "refersTo": "tarjeta",
      "description": "Pieza firma: checkpoints Creada → Enviada → Respuesta → Facturada con línea que se llena en 700ms.",
      "html": "<div class=\"ds-tracker\"><div class=\"ds-pista\"><div class=\"ds-lleno\"></div></div><div class=\"ds-paso\"><span class=\"ds-nodo ds-ok\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"#0A0A0A\"><path d=\"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg></span>Creada</div><div class=\"ds-paso\"><span class=\"ds-nodo ds-ok\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"#0A0A0A\"><path d=\"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg></span>Enviada</div><div class=\"ds-paso\"><span class=\"ds-nodo ds-curso\"></span>Respuesta</div><div class=\"ds-paso ds-pend\"><span class=\"ds-punto\"></span>Facturada</div></div>",
      "css": ".ds-tracker{font-family:Roboto,system-ui,sans-serif;position:relative;display:flex;} .ds-pista{position:absolute;top:12px;left:12.5%;right:12.5%;height:4px;border-radius:2px;background:#E6E6EA;} .ds-lleno{height:100%;width:55%;border-radius:2px;background:#0A0A0A;animation:ds-llenar 700ms cubic-bezier(0.77,0,0.175,1);} @keyframes ds-llenar{from{width:0}} .ds-paso{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:500;color:#0A0A0A;position:relative;} .ds-pend{color:#6B6B72;} .ds-nodo{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;box-sizing:border-box;} .ds-ok{background:#fff;border:2.5px solid #0A0A0A;} .ds-curso{background:#FFF1DE;border:2.5px solid #E8963A;} .ds-punto{width:18px;height:18px;margin:5px;border-radius:50%;background:#E6E6EA;}"
    }
  ],
  "narrative": {
    "northStar": "La guía de despacho",
    "overview": "**Creative North Star: \"La guía de despacho\"**\n\nCada cotización es un envío que se sigue. El sistema toma el lenguaje de las apps de seguimiento de paquetes: un número de guía grande, un estado en píldora, un tracker de checkpoints que se llena y una línea de tiempo de eventos. Todo lo demás se retira a un monocromo de alto contraste (negro, blanco y una escalera corta de grises fríos) pensado para leerse a pleno sol, con el teléfono en una mano.\n\nLa densidad es media y generosa en toques: tarjetas grises redondeadas de 24dp sobre fondo blanco, una sola tarjeta \"hero\" negra por pantalla que concentra la cifra y las acciones más usadas, y una barra de navegación en píldora flotante. El color de estado vive solo dentro de chips suaves y nodos del tracker; el ámbar de la marca aparece únicamente para decir \"pendiente, en cola o sin señal\". El tema oscuro no invierte la jerarquía: la superficie baja a carbón (#0B0B0C), la tarjeta hero sube a gris carbón y la acción principal pasa a píldora clara.\n\nSe rechaza la app de formularios gris con tarjetas iguales y una barra Material sin carácter.",
    "keyCharacteristics": [
      "Monocromo de alto contraste; ámbar como único acento de marca.",
      "Una tarjeta hero de máximo contraste por pantalla.",
      "Píldoras para toda acción, búsqueda, estado y navegación.",
      "Tracker de checkpoints como pieza firma, completo o compacto.",
      "Profundidad por tono, no por sombra; la única sombra es la de la barra flotante.",
      "Movimiento corto y firme: presión a 0.97, curvas de salida fuertes."
    ],
    "rules": [
      {
        "name": "The Ámbar Pendiente Rule",
        "body": "El ámbar significa \"todavía no salió\": en cola, sin sincronizar, valor desde caché, paso en curso. No se usa como decoración ni como color de botón.",
        "section": "colors"
      },
      {
        "name": "The Color Solo En Estado Rule",
        "body": "Azul, verde, rojo y violeta existen solo dentro de chips de estado, nodos del tracker y puntos de la línea de tiempo. Las superficies y acciones son monocromas.",
        "section": "colors"
      },
      {
        "name": "The Un Solo Hero Rule",
        "body": "Una sola superficie de máximo contraste (tarjeta hero) por pantalla.",
        "section": "colors"
      },
      {
        "name": "The Cifra Quieta Rule",
        "body": "Montos y números de guía usan cifras tabulares (\"tnum\") para no bailar al animarse ni al compararse en columna.",
        "section": "typography"
      },
      {
        "name": "The Etiqueta Sobre Dato Rule",
        "body": "Un dato se presenta como etiqueta gris en Body Small encima de su valor (estilo guía de despacho), en minúscula normal, nunca en mayúsculas espaciadas.",
        "section": "typography"
      },
      {
        "name": "The Plano Por Tono Rule",
        "body": "Las superficies se separan por tono, no por sombra. La única sombra del sistema pertenece a la barra flotante.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do dar a cada pantalla de inicio o resumen una sola tarjeta hero de máximo contraste (28dp, relleno 20dp) con la cifra en Display y como mucho dos acciones píldora.",
      "Do mostrar el estado de una cotización como tracker (completo o compacto) además del chip; el chip solo no basta.",
      "Do separar superficies por tono (blanco, Gris Niebla, Gris Pista; carbón 0 a 4 en oscuro).",
      "Do usar píldora para botones, buscadores, chips y navegación, y 24dp para tarjetas.",
      "Do aplicar efectoPresion (0.97, 120ms, EaseOutFuerte) a todo elemento tocable nuevo.",
      "Do usar cifras tabulares en montos y números de cotización.",
      "Do reservar 96dp al final de toda pantalla con barra flotante.",
      "Do definir cada estado nuevo como par fondo suave + texto saturado, con su versión nocturna."
    ],
    "donts": [
      "Don't usar el ámbar para nada que no sea \"pendiente, en cola, sin sincronizar o en curso\".",
      "Don't poner azul, verde, rojo o violeta en superficies, botones o encabezados; ese color pertenece a los estados.",
      "Don't agregar sombras a tarjetas; la única sombra es la de la barra flotante.",
      "Don't poner dos tarjetas hero en la misma pantalla.",
      "Don't usar colores dinámicos del sistema (Material You); la paleta propia es fija.",
      "Don't escribir etiquetas de dato en mayúsculas espaciadas sobre los valores."
    ]
  }
}